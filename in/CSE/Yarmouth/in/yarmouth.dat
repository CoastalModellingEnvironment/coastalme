Number of layers                                                                             : 1
; BASEMENT DEM MUST BE PRESENT
Basement DEM file                                                             [path and name]: CSE/Yarmouth/in/GY_basement.tif
   ; LAYER 0 THICKNESS FILES, LAYER 0 IS LOWEST
